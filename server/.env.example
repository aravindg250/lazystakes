# ===============================================================
# LazyStakes server — environment template
#
# Copy to `.env` for local runs (`copy .env.example .env` on Windows).
# In production, set these in Railway's dashboard instead — never commit
# a real value. Everything in here is SECRET (except SUPABASE_URL), unlike
# the app's .env.
# ===============================================================

# Supabase → Connect → "Session pooler" (not "Direct connection", which is
# IPv6-only). Paste the URI and substitute your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Stripe → Developers → API keys. Use the TEST secret key (sk_test_...) until
# Phase 4. The exit-test script refuses to run with a live key.
STRIPE_SECRET_KEY=sk_test_

# Supabase → Project Settings → API → Project URL. Not a secret. The API uses
# it to check sign-in tokens; without it every /v1 request gets a 401.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Port for the HTTP API. Railway sets this automatically.
PORT=3000

# Run the cron jobs in this process. Keep exactly one instance with this on
# (the jobs are safe to double-run, but there's no reason to).
JOBS_ENABLED=true

# Push notifications (6 pm reminder, 10 pm warning, charge receipts).
# Off until the app registers push tokens in a later phase. When off, nothing
# is sent and nothing is logged as sent.
NOTIFICATIONS_ENABLED=false

# DEVELOPMENT ONLY. Lets requests pick a user with an `x-dev-user-id` header
# instead of signing in. Must be false in production:
# with it on, anyone who can reach the API can act as any user.
DEV_AUTH=false
