# ===============================================================
# Gymstakes — app environment template
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this file is committed so anyone cloning the repo knows what's needed.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
# ===============================================================


# ---------------------------------------------------------------
# READ THIS BEFORE ADDING ANYTHING
# ---------------------------------------------------------------
# Expo inlines every EXPO_PUBLIC_* variable directly into the JavaScript
# bundle at build time. It ships to every user's phone and can be extracted
# from the app in about thirty seconds.
#
# So: EXPO_PUBLIC_ does NOT mean "environment variable". It means "public".
#
# Only keys that are designed to be published belong in this file. Anything
# secret lives on the backend, set through Railway's dashboard, and never
# appears in this repo at all. There is a list at the bottom of what those
# are, so you don't accidentally reach for one here.
# ---------------------------------------------------------------


# ---------------------------------------------------------------
# Backend
# ---------------------------------------------------------------
# Your Railway service. No trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:3000


# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
# The anon key is meant to be public — it's what the app authenticates
# with, and row-level security is what actually protects your data. If you
# haven't enabled RLS on your tables, the anon key is dangerous; the fix is
# turning on RLS, not hiding the key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------
# The publishable key starts with pk_ and is safe in the bundle. If a key
# in this file starts with sk_, stop — that's a secret key and it does not
# belong in the app under any circumstances.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_


# ---------------------------------------------------------------
# Build flags
# ---------------------------------------------------------------
# Set to false in production builds to hide the scenario switcher and
# other build-time affordances.
EXPO_PUBLIC_SHOW_DEV_TOOLS=true


# ===============================================================
# SERVER-ONLY — these never go in this file or this repo
# ===============================================================
#
#   STRIPE_SECRET_KEY            sk_live_... / sk_test_...
#   STRIPE_WEBHOOK_SECRET        whsec_...
#   SUPABASE_SERVICE_ROLE_KEY    bypasses row-level security entirely
#   DATABASE_URL                 direct Postgres connection string
#   APPLE_PRIVATE_KEY            .p8 contents for Sign in with Apple
#
# These belong in Railway's environment variables, set through their
# dashboard. If one of them ever lands in a commit, rotating the key is
# the only real fix — rewriting git history is unreliable and assumes
# nobody cloned or mirrored the repo in the meantime.
# ===============================================================